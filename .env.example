# RouteOn 환경변수 — 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

# GraphHopper — 호스트에서 Java 서비스로 실행 (포트 8989)
# Docker 내부에서 호스트로 접근할 때: http://host.docker.internal:8989
GRAPHHOPPER_BASE_URL=http://host.docker.internal:8989

# 카카오 (주소→좌표 변환, 근처 장소 검색에만 사용)
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=

POSTGRES_USER=routeon
POSTGRES_PASSWORD=
POSTGRES_DB=routeon

JWT_SECRET=

CODE_SERVER_PASSWORD=

SMTP_EMAIL=
SMTP_PASSWORD=
